# ==============================================================================
# SOAR Lite Configuration
# Copy this file to '.env' and adjust the settings as needed.
# ==============================================================================

# Execution Mode:
# 'real'        - Approved actions execute real network containment (OS firewall, DNS sinkhole, Supabase session revoke)
# 'simulation'  - Dry-run only; changes in-memory & database records without altering network infrastructure
EXECUTION_MODE=simulation

# Supabase PostgreSQL Database (Cloud Persistence)
# Get these values from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Fallback Local Database Path (used when Supabase is not configured)
SQLITE_DB_PATH=soar_lite.db

# Network Containment Settings
ENABLE_FIREWALL_BLOCK=true
ENABLE_HOSTS_BLOCK=true

# Incident Alert Webhook (Slack, Microsoft Teams, Discord, SIEM)
# e.g., https://hooks.slack.com/services/... or https://discord.com/api/webhooks/...
ALERT_WEBHOOK_URL=

# Optional Threat Intelligence API Keys
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
